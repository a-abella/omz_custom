# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
    name = Antonio Abella
    email = antonio.abella@ensorahealth.com

[color]
    ui = auto

## Make git better | https://blog.gitbutler.com/how-git-core-devs-configure-git/
# clearly makes git better
[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true

# why the hell not?

[help]
        autocorrect = prompt
[commit]
        verbose = true
# affects rebase behavior, would rather it be default
#[rerere]
#        enabled = true
#        autoupdate = true
[core]
        excludesfile = ~/.gitignoreglobal
        # faster git status data, subscribes to filesystem events and caches data
        fsmonitor = true
        untrackedCache = true

[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true

